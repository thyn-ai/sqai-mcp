{
  "name": "@thyn-ai/sqai",
  "version": "0.1.18",
  "description": "SQAI (Structured Query AI) — the deterministic, read-only structured-data SDK for AI agents, with full provenance.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unsafe": {
      "types": "./dist/unsafe.d.ts",
      "import": "./dist/unsafe.js",
      "require": "./dist/unsafe.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "algenta-sdk": "1.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thyn-ai/sqai.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://sqai.com",
  "keywords": [
    "ai",
    "agents",
    "structured-data",
    "deterministic",
    "read-only",
    "sqai"
  ]
}
